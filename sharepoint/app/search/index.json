{
  "name": "documents-index",
  "fields": [
    { "name": "id", "type": "Edm.String", "key": true, "filterable": true, "analyzer": "keyword" },
    { "name": "parent_id", "type": "Edm.String", "filterable": true, "searchable": false },
    { "name": "chunk_id", "type": "Edm.String", "filterable": true, "searchable": false },
    { "name": "title", "type": "Edm.String", "searchable": true, "filterable": true, "sortable": true, "retrievable": true },
    { "name": "content", "type": "Edm.String", "searchable": true, "retrievable": true, "analyzer": "standard.lucene" },
    {
      "name": "content_vector",
      "type": "Collection(Edm.Single)",
      "searchable": true,
      "retrievable": false,
      "dimensions": 1536,
      "vectorSearchProfile": "default-vector-profile"
    },
    { "name": "page_number", "type": "Edm.Int32", "filterable": true, "sortable": true },
    { "name": "layout_type", "type": "Edm.String", "filterable": true, "facetable": true, "searchable": false },
    { "name": "source_url", "type": "Edm.String", "filterable": true, "retrievable": true, "searchable": false },
    { "name": "content_preview_url", "type": "Edm.String", "retrievable": true, "searchable": false },
    { "name": "file_name", "type": "Edm.String", "filterable": true, "searchable": true, "retrievable": true },
    { "name": "file_type", "type": "Edm.String", "filterable": true, "facetable": true, "searchable": false },
    { "name": "author", "type": "Edm.String", "filterable": true, "searchable": true },
    { "name": "last_modified", "type": "Edm.DateTimeOffset", "filterable": true, "sortable": true },
    { "name": "created_date", "type": "Edm.DateTimeOffset", "filterable": true, "sortable": true },
    { "name": "content_source", "type": "Edm.String", "filterable": true, "facetable": true, "searchable": false },
    { "name": "key_phrases", "type": "Collection(Edm.String)", "filterable": true, "facetable": true, "searchable": true },
    { "name": "entities", "type": "Collection(Edm.String)", "filterable": true, "facetable": true, "searchable": true },
    { "name": "tags", "type": "Collection(Edm.String)", "filterable": true, "facetable": true, "searchable": true },
    { "name": "excluded", "type": "Edm.Boolean", "filterable": true },
    { "name": "metadata_json", "type": "Edm.String", "searchable": false, "retrievable": true },
    { "name": "metadata_spo_item_path", "type": "Edm.String", "retrievable": true, "searchable": false, "filterable": false }
  ],
  "vectorSearch": {
    "algorithms": [
      {
        "name": "hnsw-algorithm",
        "kind": "hnsw",
        "hnswParameters": {
          "m": 4,
          "efConstruction": 400,
          "efSearch": 500,
          "metric": "cosine"
        }
      }
    ],
    "profiles": [
      {
        "name": "default-vector-profile",
        "algorithm": "hnsw-algorithm",
        "vectorizer": "ai-foundry-vectorizer"
      }
    ],
    "vectorizers": [
      {
        "name": "ai-foundry-vectorizer",
        "kind": "azureOpenAI",
        "azureOpenAIParameters": {
          "resourceUri": "{{AI_SERVICES_ENDPOINT}}",
          "deploymentId": "text-embedding-3-small",
          "modelName": "text-embedding-3-small"
        }
      }
    ]
  },
  "semantic": {
    "defaultConfiguration": "default-semantic-config",
    "configurations": [
      {
        "name": "default-semantic-config",
        "prioritizedFields": {
          "titleField": { "fieldName": "title" },
          "prioritizedContentFields": [
            { "fieldName": "content" }
          ],
          "prioritizedKeywordsFields": [
            { "fieldName": "key_phrases" },
            { "fieldName": "tags" }
          ]
        }
      }
    ]
  },
  "scoringProfiles": [
    {
      "name": "boost-tagged",
      "text": {
        "weights": {
          "title": 3,
          "tags": 2,
          "key_phrases": 1.5,
          "content": 1
        }
      }
    }
  ],
  "suggesters": [
    {
      "name": "sg",
      "searchMode": "analyzingInfixMatching",
      "sourceFields": ["title", "file_name", "tags"]
    }
  ]
}
